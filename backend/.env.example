PORT=5000
NODE_ENV=development

# Database configuration
# For local instant dev: file:./dev.db
# For PostgreSQL / Docker: postgresql://travel_user:travel_password@localhost:5432/travel_db?schema=public
DATABASE_URL="file:./dev.db"

# Redis Cache configuration
# For local with Redis: redis://localhost:6379
# If Redis is unavailable, the server automatically uses in-memory cache fallback!
REDIS_URL="redis://localhost:6379"

# JWT Secret
JWT_SECRET="travel_platform_super_secret_jwt_key_2026_xyz"
JWT_EXPIRES_IN="7d"

# Gmail / Email Configuration for OTP Verification
# Provide your Gmail credentials to send real OTP emails
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="Smart Travel <noreply@smarttravel.com>"

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"
